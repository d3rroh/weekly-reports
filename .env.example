# Copy to .env and replace every placeholder. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=reports.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://reports.example.com

# MySQL
DB_ENGINE=mysql
DB_NAME=weekly_outcomes
DB_USER=weekly_outcomes_app
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Fallback timezone used until an administrator sets the business timezone
DEFAULT_BUSINESS_TIMEZONE=UTC

# Security (production)
SECURE_COOKIES=true
SECURE_SSL_REDIRECT=false
USE_X_FORWARDED_PROTO=true
SECURE_HSTS_SECONDS=31536000

# Login throttling
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_SECONDS=900

# Email for password reset (console backend prints emails to the log)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=weekly-review@example.com
